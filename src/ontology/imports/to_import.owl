    <!-- http://purl.obolibrary.org/obo/CHEBI_33833 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_33833">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24532"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33659"/>
        <obo1:IAO_0000115>A heterocyclic compound formally derived from an arene by replacement of one or more methine (-C=) and/or vinylene (-CH=CH-) groups by trivalent or divalent heteroatoms, respectively, in such a way as to maintain the continuous pi-electron system characteristic of aromatic systems and a number of out-of-plane pi-electrons corresponding to the Hueckel rule (4n+2).</obo1:IAO_0000115>
        <oboInOwl:hasExactSynonym>heteroarenes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>hetarenes</oboInOwl:hasRelatedSynonym>
        <rdfs:label>heteroarene</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33833"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>heteroarenes</owl:annotatedTarget>
        <oboInOwl:hasDbXref>IUPAC</oboInOwl:hasDbXref>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/chebi#IUPAC_NAME"/>
    </owl:Axiom>
    <owl:Axiom>
