        <owl:annotatedTarget>A phosphorus content trait TO:0001024 which is the phosphorus cation (CHEBI:33467) composition in a root system (PO:0025025).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>TO:cooperl</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://search.proquest.com/docview/1426182399</oboInOwl:hasDbXref>
    </owl:Axiom>
    


