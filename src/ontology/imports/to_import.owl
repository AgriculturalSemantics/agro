    <!-- http://purl.obolibrary.org/obo/PO_0006005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0006005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025430"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0000229"/>
            </owl:Restriction>
