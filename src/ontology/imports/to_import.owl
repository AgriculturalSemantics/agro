    <!-- http://purl.obolibrary.org/obo/PO_0004542 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0004542">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025029"/>
        <obo1:IAO_0000115>A swollen shoot axis (PO:0025029) that grows horizontally at or below the substrate surface and produces shoots above and roots or rhizoids below.</obo1:IAO_0000115>
        <oboInOwl:hasDbXref>PO_GIT:142</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>rizoma (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>根茎=root stock (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>rootstock (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PO:0004542</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#TraitNet"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/po#reference"/>
        <rdfs:comment>In ferns and many monocots, a rhizome is a primary axis (stem), while in other species, it is a branch. Usually produces scale-like leaves.</rdfs:comment>
        <rdfs:label>rhizome</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PO_0004542"/>
