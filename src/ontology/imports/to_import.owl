    <!-- http://purl.obolibrary.org/obo/GO_0098772 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0098772">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0003674"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0005515"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115>A molecular function regulator regulates the activity of its target via non-covalent binding that does not result in covalent modification to the target. Examples of molecular function regulators include regulatory subunits of multimeric enzymes and channels. Mechanisms of regulation include allosteric changes in the target and competitive inhibition.</obo1:IAO_0000115>
        <oboInOwl:hasExactSynonym>molecular function regulator</oboInOwl:hasExactSynonym>
        <rdfs:label>molecular function regulator activity</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0098772"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A molecular function regulator regulates the activity of its target via non-covalent binding that does not result in covalent modification to the target. Examples of molecular function regulators include regulatory subunits of multimeric enzymes and channels. Mechanisms of regulation include allosteric changes in the target and competitive inhibition.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:dos</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:pt</oboInOwl:hasDbXref>
    </owl:Axiom>
    


