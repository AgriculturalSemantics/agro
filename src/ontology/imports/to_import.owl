    <!-- http://purl.obolibrary.org/obo/PO_0009001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0009001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025496"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0009062"/>
